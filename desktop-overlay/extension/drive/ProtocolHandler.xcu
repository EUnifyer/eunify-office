<?xml version="1.0" encoding="UTF-8"?>
<!--
  Register the Drive protocol handler so LibreOffice routes
  com.eunifyer.drive:* URLs to our Python dispatch handler.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="ProtocolHandler"
                    oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="com.eunifyer.drive.MenuHandler" oor:op="replace">
      <prop oor:name="Protocols">
        <value>com.eunifyer.drive:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
