<?xml version="1.0" encoding="UTF-8"?>
<!--
  Register the auth gate as a startup job.
  LibreOffice runs this automatically when the application launches.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Jobs"
                    oor:package="org.openoffice.Office">
  <node oor:name="Jobs">
    <node oor:name="EUnifyerAuthGate" oor:op="replace">
      <prop oor:name="Service">
        <value>com.eunifyer.auth.StartupJob</value>
      </prop>
    </node>
  </node>
  <node oor:name="Events">
    <node oor:name="OnStartApp" oor:op="replace">
      <node oor:name="JobList">
        <node oor:name="EUnifyerAuthGate" oor:op="replace">
          <prop oor:name="Service">
            <value>com.eunifyer.auth.StartupJob</value>
          </prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
